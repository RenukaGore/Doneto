<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Foundation Panel</title>
    <link rel="icon" type="image/x-icon" href="/upload/title_logo.png">
    
    <link rel="apple-touch-icon" href="/upload/title_logo.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <!-- <link rel="stylesheet" href="style.css"> -->
</head>
<body>
<style>* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    background: linear-gradient(135deg, #0f2027, #0d181c, #0d1c22);
    color: #fff;
}
/* body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f3f5;
} */

/* SIDEBAR */
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 100vh;
    background: #212529;
    color: white;
    padding-top: 15px;
    transition: 0.3s;
    z-index: 1000;
    
}

.sidebar a {
    display: block;
    padding: 12px 20px;
    color: white;
    text-decoration: none;
}

.sidebar a:hover {
    background: #343a40;
}

/* MAIN CONTENT */
.main-content {
    margin-left: 250px;
    padding: 20px;
    transition: 0.3s;
}

/* TOPBAR */
.topbar {
    background: white;
    padding: 12px 20px;
    border-radius: 8px;
}

.admin-profile img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

/* RESPONSIVE */
@media (max-width: 768px) {

    .sidebar {
        left: -250px;
    }

    .sidebar.active {
        left: 0;
    }

    .main-content {
        margin-left: 0;
    }
}

/* SIDEBAR */


.logo {
    text-align: center;
    font-weight: bold;
    margin-bottom: 30px;
}



/* MAIN CONTENT */


/* TOP BAR */



.admin-profile img {
    border-radius: 50%;
}

/* STATS */
.stat-card {
    background: rgba(255,255,255,0.1);
    border-radius: 15px;
    padding: 25px;
    text-align: center;
    backdrop-filter: blur(12px);
    transition: 0.4s;
    animation: fadeUp 0.8s ease;
}

.stat-card i {
    font-size: 28px;
    margin-bottom: 10px;
    color: #00c6ff;
}

.stat-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

/* GLASS CARD */
.glass-card {
    background: rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 25px;
    backdrop-filter: blur(15px);
    animation: fadeUp 1s ease;
}

/* ANIMATION */
@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
    
}

:root{
        --primary: #68d9ff;
    --primary-hover: #4f46e5;
    --bg-gradient: rgba(0, 0, 0, 0.365);
    --glass: rgba(73, 73, 73, 0);
}



.container {
    width: 100%;
    max-width: 100%;
    perspective: 1000px;
    color: white;
    /* margin-top: 500px; */
}

.animated-form {
    background: var(--glass);
    padding: 40px;
    border-radius: 20px;
    /* box-shadow: 0 15px 35px rgba(0,0,0,0.2); */
    animation: slideIn 0.8s ease-out;
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

h2 { color: #333; margin-bottom: 5px; text-align: center; }
.subtitle { text-align: center; color: #666; margin-bottom: 30px; font-size: 0.9em; }

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    color:white;
}

.full-width { grid-column: span 2; }

/* Animated Input Group */
.input-group {
    position: relative;
    margin-bottom: 10px;
}

.input-group input, 
.input-group textarea, 
.input-group select {
    width: 100%;
    padding: 12px 0;
    font-size: 16px;
    color: #ffffff;
    border: none;
    border-bottom: 2px solid #ddd;
    outline: none;
    background: transparent;
    transition: border-color 0.3s;
}

.input-group label {
    position: absolute;
    top: 12px;
    left: 0;
    color: #999;
    pointer-events: none;
    transition: all 0.3s ease;
}

/* Float Label Animation */
.input-group input:focus ~ label,
.input-group input:valid ~ label,
.input-group textarea:focus ~ label,
.input-group textarea:valid ~ label {
    top: -15px;
    font-size: 12px;
    color: var(--primary);
    font-weight: bold;
}

.input-group input:focus, 
.input-group textarea:focus {
    border-bottom: 2px solid var(--primary);
}

.static-label {
    top: -15px !important;
    font-size: 12px !important;
}

/* Social Section */
.social-section {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px dashed #ddd;
}

.social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 15px;
}

.submit-btn {
    width: 100%;
    padding: 15px;
    margin-top: 30px;
    border: none;
    border-radius: 10px;
    background: var(--primary);
    color: white;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
}

.submit-btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4);
}

/* Responsive */
@media (max-width: 600px) {
    .form-grid, .social-grid { grid-template-columns: 1fr; }
    .full-width { grid-column: span 1; }
}

</style>
<!-- SIDEBAR -->
<div class="sidebar">
    <h3 class="logo bg-white text-dark mx-3 p-2 rounded text-center">
        <%= foundation[0].foundation_name %>
    </h3>

    <a href="/foundation"><i class="fa fa-gauge me-2"></i> Dashboard</a>
    <a href="/foundation/edit_details"><i class="fa fa-circle-plus me-2"></i> Edit Portal</a>
    <a href="/foundation/donor"><i class="fa fa-users me-2"></i> Donors & Fund</a>
    <!-- <a href="/foundation/fund_detail"><i class="fa fa-database me-2"></i> Fund Detail</a> -->
    <a href="/foundation/logout"><i class="fa fa-sign-out-alt me-2"></i> Logout</a>
</div>

