<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/upload/title_logo.png">
    
    <link rel="apple-touch-icon" href="/upload/title_logo.png">
    
</head>
<body>
<div class="container align-items-center">
        <form class="animated-form" action="/foundation/foundation_request" method="post" enctype="multipart/form-data">
            <h2 class="text-white">Foundation Registration</h2>
            <p class="subtitle">Enter your organization's details below</p>

            <div class="form-grid">
                <div class="input-group full-width">
                    <input type="text" name="foundation_name" >
                    <label>Foundation Name</label>
                </div>

                <div class="input-group full-width">
                    <textarea name="description" rows="3" ></textarea>
                    <label>Description</label>
                </div>

                <div class="input-group">
                    <input type="email" name="email" >
                    <label>Email Address</label>
                </div>

                <div class="input-group">
                    <input type="tel" name="phone" >
                    <label>Phone Number</label>
                </div>
                <div class="input-group">
                    <input type="password" name="password" >
                    <label>Password</label>
                </div>

                <div class="input-group">
                    <input type="file" name="logo_image" placeholder="Image URL or Path">
                    <label class="static-label">Logo Image URL</label>
                </div>

                <div class="input-group">
                    <input type="number" name="created_year" min="1800" max="2025" >
                    <label>Year Created</label>
                </div>

                <div class="input-group full-width">
                    <input type="text" name="address" >
                    <label>Physical Address</label>
                </div>

                <div class="input-group">
                    <input type="url" name="website">
                    <label>Website URL</label>
                </div>

                <div class="input-group ">
                    <select name="status" class="text-info">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                    <label class="static-label">Status</label>
                </div>

                <div class="social-section full-width">
                    <h3 class="">Social Media Links</h3>
                    <div class="social-grid mt-4">
                        <div class="input-group">
                            <input type="text" name="facebook">
                            <label>Facebook</label>
                        </div>
                        <div class="input-group">
                            <input type="text" name="instagram">
                            <label>Instagram</label>
                        </div>
                        <div class="input-group">
                            <input type="text" name="twitter">
                            <label>Twitter</label>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="submit-btn">Request</button>
        </form>
    </div>

<style>
    body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--bg-gradient);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 20px;
}
:root{
        --primary: #6366f1;
    --primary-hover: #4f46e5;
    --bg-gradient: rgba(0, 0, 0, 0.365);
    --glass: rgba(255, 255, 255, 0.95);
}



.container {
    width: 100%;
    max-width: 800px;
    perspective: 1000px;
    /* margin-top: 500px; */
}

.animated-form {
    background: var(--glass);
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    animation: slideIn 0.8s ease-out;
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

h2 { color: #333; margin-bottom: 5px; text-align: center; }
.subtitle { text-align: center; color: #666; margin-bottom: 30px; font-size: 0.9em; }

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.full-width { grid-column: span 2; }

/* Animated Input Group */
.input-group {
    position: relative;
    margin-bottom: 10px;
}

.input-group input, 
.input-group textarea, 
.input-group select {
    width: 100%;
    padding: 12px 0;
    font-size: 16px;
    color: #333;
    border: none;
    border-bottom: 2px solid #ddd;
    outline: none;
    background: transparent;
    transition: border-color 0.3s;
}

.input-group label {
    position: absolute;
    top: 12px;
    left: 0;
    color: #999;
    pointer-events: none;
    transition: all 0.3s ease;
}

/* Float Label Animation */
.input-group input:focus ~ label,
.input-group input:valid ~ label,
.input-group textarea:focus ~ label,
.input-group textarea:valid ~ label {
    top: -15px;
    font-size: 12px;
    color: var(--primary);
    font-weight: bold;
}

.input-group input:focus, 
.input-group textarea:focus {
    border-bottom: 2px solid var(--primary);
}

.static-label {
    top: -15px !important;
    font-size: 12px !important;
}

/* Social Section */
.social-section {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px dashed #ddd;
}

.social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 15px;
}

.submit-btn {
    width: 100%;
    padding: 15px;
    margin-top: 30px;
    border: none;
    border-radius: 10px;
    background: var(--primary);
    color: white;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
}

.submit-btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4);
}

/* Responsive */
@media (max-width: 600px) {
    .form-grid, .social-grid { grid-template-columns: 1fr; }
    .full-width { grid-column: span 1; }
}
</style>
</body>
</html>



