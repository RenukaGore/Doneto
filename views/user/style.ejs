<style>
/* ===== GLOBAL ===== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Poppins", sans-serif;
}



/* NAVBAR */
.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 16px 60px;
  /* background: rgba(255,255,255,0.75); */
  background: linear-gradient(135deg,#000000,#000000, #ffffff, #ffffff,#000000, #000000);

  backdrop-filter: blur(14px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: 0.4s ease;
  z-index: 1000;
}

.navbar.scrolled {
  padding: 12px 60px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* LOGO */
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}

.logo img {
  width: 48px;
  height: 48px;

  animation: logoPulse 3s infinite;
  filter: drop-shadow(0 0 10px rgba(214,0,0,0.4));
}

.logo span {
  font-size: 24px;
  font-weight: 800;
  color: #d60000;
  letter-spacing: 1px;
}

@keyframes logoPulse {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* LINKS */
.nav-links {
  display: flex;
  list-style: none;
  gap: 40px;
  
}

.nav-links li {
  animation: navFade 0.6s ease forwards;
  animation-delay: calc(var(--i) * 0.1s);
  opacity: 0;
}

@keyframes navFade {
  from {
    opacity: 0;
    transform: translateY(-15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.nav-links a {
  text-decoration: none;
  color: #111;
  font-weight: 600;
  position: relative;
  transition: 0.3s;
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8px;
  width: 0%;
  height: 3px;
 
  background: #d60000;
  transition: 0.4s ease;
  transform: translateX(-50%);
}

.nav-links a:hover::after {
  width: 100%;
  
}

.nav-links a:hover {
  transform: translateY(-4px);
}

/* DONATE BUTTON */
.donate-btn {
  position: relative;
  background: linear-gradient(135deg,#ff4b4b,#d60000);
  color: white;
  padding: 12px 28px;
  border-radius: 50px;
  font-weight: 700;
  text-decoration: none;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(214,0,0,0.4);
  transition: transform 0.3s ease;
}

.donate-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg,transparent,rgba(255,255,255,0.6),transparent);
  animation: shine 2.5s infinite;
}

@keyframes shine {
  100% { left: 100%; }
}

.donate-btn:hover {
  transform: translateY(-5px) scale(1.05);
}

/* MOBILE */
.menu-toggle {
  display: none;
  font-size: 30px;
  cursor: pointer;
}

/* RESPONSIVE */
@media(max-width: 900px) {
  .nav-links {
    position: absolute;
    top: 85px;
    right: 30px;
    background: white;
    flex-direction: column;
    padding: 25px;
    gap: 25px;
    border-radius: 20px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.15);
    transform: scale(0.8);
    opacity: 0;
    pointer-events: none;
    transition: 0.4s ease;
  }

  .nav-links.active {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .menu-toggle {
    display: block;
  }

  .donate-btn {
    display: none;
  }
}

/* Footer Styles */
.footer {
  background: transparent;
  color: #fff;
  padding: 50px 20px 20px 20px;
  font-family: 'Poppins', sans-serif;
  position: relative;
  overflow: hidden;
  margin-top: 100px;
  border-top: 1px solid white;
  
}

.footer-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 30px;
  max-width: 1200px;
  margin: auto;
}

.footer-section h2,
.footer-section h3 {
  font-weight: 700;
  margin-bottom: 15px;
}

.footer-section p,
.footer-section li,
.footer-section a {
  color: #fff;
  font-size: 14px;
  line-height: 1.6;
  text-decoration: none;
  transition: 0.3s ease;
}

.footer-section a:hover {
  color: #ffdd59;
}

.footer-section ul {
  list-style: none;
  padding: 0;
}

.footer-section li {
  margin-bottom: 10px;
}

/* Social Icons */
.social-icons a {
  display: inline-block;
  margin-right: 10px;
  color: #fff;
  font-size: 18px;
  transition: 0.3s ease;
  transform: scale(1);
}

.social-icons a:hover {
  color: #ffdd59;
  transform: scale(1.2) rotate(10deg);
}

/* Footer Bottom */
.footer-bottom {
  text-align: center;
  padding-top: 20px;
  font-size: 13px;
  opacity: 0.8;
}

/* Fade-in animation */
.footer-container > div {
  opacity: 0;
  transform: translateY(30px);
  animation: fadeInUp 1s forwards;
}

.footer-container > div:nth-child(1) { animation-delay: 0.2s; }
.footer-container > div:nth-child(2) { animation-delay: 0.4s; }
.footer-container > div:nth-child(3) { animation-delay: 0.6s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .footer-container {
    flex-direction: column;
  }
}

/* slider */

.hero-slider {
  position: relative;
}

.carousel-item {
  height: 90vh;
}

.carousel-item img {
  height: 100%;
  object-fit: cover;
}

.overlay {
  position: absolute;
