}

.carousel-caption h1 {
  font-size: 3.5rem;
  font-weight: 700;
}

.carousel-caption p {
  font-size: 1.2rem;
  margin-bottom: 20px;
}

.carousel-caption .btn {
  padding: 12px 35px;
