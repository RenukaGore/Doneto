    <script>
        function checkpass(val_new, val_conf) {
            var new_pass = document.getElementById(val_new).value;
            var confirm_pass = document.getElementById(val_conf).value;
            var button = document.getElementById('change_password')
            if (new_pass.length < 8) {
                document.getElementById('new_pass').innerText = "❌ Passwords must have 8 character"
                button.style = "cursor:not-allowed;"
                button.disabled = true;

            } else {
                document.getElementById('new_pass').innerText = ""
                if (new_pass !== confirm_pass) {
                    document.getElementById('change').innerText = "❌ Passwords Do Not Match"
                    button.style = "cursor:not-allowed;"
                    button.disabled = true;

                } else {
                    document.getElementById('change').innerText = "✅ Passwords Match"
                    button.disabled = false;
                    button.style = "cursor:pointer;"

                }
            }
        }
        function togglePassword(id,icon) {
            var field = document.getElementById(id);
            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                field.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>

</html>