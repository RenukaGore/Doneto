<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>DoneTo</title>
  <link rel="icon" type="image/x-icon" href="/upload/title_logo.png">
    
    <link rel="apple-touch-icon" href="/upload/title_logo.png">

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <!-- Animate CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
    integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"
    crossorigin="anonymous"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>



<body>
  <div id="loader">
    <div class="loader-content">
        <div class="heart-wrapper">
            <i class="fa-solid fa-heart heart"></i>
            <div class="pulse"></div>
        </div>
        <h3 class="brand">Doneto</h3>
        <p class="loading-text">Spreading Kindness...</p>
    </div>
</div>
  <header class="navbar" id="navbar">
    <div class="logo ml-3">
      <!-- <img src="/upload/<%= site[0].site_logo %>" alt="Done-To Logo">  -->
      <span>
        <%= site[0].site_name %>
      </span>
    </div>

    <nav>
      <ul class="nav-links pt-3 ">
        <li style="--i:1"><a href="/">Home</a></li>
        <li style="--i:2"><a href="/about">About</a></li>
        <li style="--i:4"><a href="/foundation_page">Foundation</a></li>
        <li style="--i:5"><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <% if(is_login){%>
      <p><a style="color: white;margin-right: 10px;" href="/logout"> <i class="fa fa-sign-out-alt fa-sm "></i>
          Logout</a>
        <a style="color: white;" href="/profile"> <i class="fa fa-user"></i> profile</a>
      </p>

      <%}else{%>
        <a href="/login" class="donate-btn">Login</a>
        <%}%>

          <div class="menu-toggle">&#9776;</div>
  </header>
  <!-- slider -->



  <section class="hero-slider">
    <div id="mainSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">

      <!-- Indicators -->
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active"></button>

        <% slider.map(function(item,i){ %>

          <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="<%=i+1 %>"></button>
          <% }) %>

      </div>

      <!-- Slides -->
      <div class="carousel-inner">

        <!-- Slide  -->
        <div class="carousel-item active">
          <img src="upload\1766779039117slide1.jpeg" class="d-block w-100" alt="">
          <div class="overlay"></div>
          <div class="carousel-caption">
            <h1 class="animate__animated animate__fadeInDown">Together We Can Help</h1>
            <p class="animate__animated animate__fadeInUp">Your donation can change lives</p>
            <a href="/foundation_page" class="donate-btn btn btn-danger btn-lg animate__animated animate__zoomIn">Donate</a>
          </div>
        </div>
        <% slider.map(function(item,i){ %>
          <div class="carousel-item ">
            <img src="upload/<%= item.slider_image %>" class="d-block w-100" alt="">
            <div class="overlay"></div>
            <div class="carousel-caption">
              <h1 class="animate__animated animate__fadeInDown">
                <%= item.slider_title %>
              </h1>
              <p class="animate__animated animate__fadeInUp">
                <%= item.slider_discription %>
              </p>
              <a href="<%= item.slider_btn_url %>"
                class="donate-btn btn btn-danger btn-lg animate__animated animate__zoomIn">
                <%= item.slider_btn_text %>
              </a>
            </div>
          </div>
          <% }) %>

      </div>

      <!-- Controls -->
      <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>

      <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>

    </div>
  </section>
  <div class="cic"></div>