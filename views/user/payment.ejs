<html>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  var options = {
    "key": "rzp_test_bpN3aN81Oaf8Mo",
    "amount": `<%= amount * 100 %> `,
    "currency": "INR",
    "name": "<%= foundation[0].foundation_name %>",
    "description": "Test Payment",
    "image": "https://www.freepik.com/free-photos-vectors/4k-wallpaper-cat",

    "method": {
      "upi": true,
      "card": true,
      "wallet": true,
      "netbanking": true,
      "emi": true
    },

    // ✅ AUTO REDIRECT URL AFTER PAYMENT
    "callback_url": "http://localhost:2000/check_payment/"+'<%= donation_id %>', 
    "redirect": true,

    "prefill": {
      "name": '<%= foundation[0].foundation_name %>',
      "email": "<%= foundation[0].email %>",
      "contact": "<%= foundation[0].phone %>"
    },

    "theme": {
      "color": "#3399cc"
    }
  };

  var rzp1 = new Razorpay(options);

  
    rzp1.open();
    e.preventDefault();
  
</script>
</html>     