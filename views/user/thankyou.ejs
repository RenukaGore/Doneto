<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Thank You for Your Donation</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
/* ===== RESET ===== */
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

/* ===== BACKGROUND ===== */
body{
  min-height:100vh;
  background:linear-gradient(135deg,#11998e,#38ef7d);
  display:flex;
  justify-content:center;
  align-items:center;
}

/* ===== CARD ===== */
.thank-card{
  width:450px;
  background:#fff;
  border-radius:20px;
  padding:35px;
  text-align:center;
  box-shadow:0 25px 50px rgba(0,0,0,.25);
  animation:fadeScale .9s ease;
}

@keyframes fadeScale{
  from{opacity:0;transform:scale(.85);}
  to{opacity:1;transform:scale(1);}
}

/* ===== CHECK ICON ===== */
.check{
  width:80px;
  height:80px;
  background:#38ef7d;
  color:#fff;
  border-radius:50%;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:40px;
  margin:0 auto 20px;
  animation:pulse 1.5s infinite;
}

@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(56,239,125,.6);}
  70%{box-shadow:0 0 0 25px rgba(56,239,125,0);}
  100%{box-shadow:0 0 0 0 rgba(56,239,125,0);}
}

/* ===== TEXT ===== */
.thank-card h1{
  color:#11998e;
  font-size:28px;
  margin-bottom:8px;
}

.thank-card p{
  color:#555;
  font-size:15px;
  margin-bottom:25px;
}

/* ===== SUMMARY ===== */
.summary{
  background:#f7f7f7;
  border-radius:14px;
  padding:18px;
  margin-bottom:25px;
  text-align:left;
}

.summary h3{
  color:#333;
  margin-bottom:12px;
}

.summary div{
  display:flex;
  justify-content:space-between;
  margin-bottom:8px;
  font-size:14px;
  color:#444;
}

/* ===== BUTTONS ===== */
.actions{
  display:flex;
  gap:15px;
}

.actions a{
  flex:1;
  padding:12px;
  border-radius:30px;
  text-decoration:none;
  font-weight:600;
  text-align:center;
  transition:.4s;
}

.invoice-btn{
  background:linear-gradient(135deg,#11998e,#38ef7d);
  color:#fff;
}

.home-btn{
  border:2px solid #38ef7d;
  color:#11998e;
}

.actions a:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 20px rgba(0,0,0,.2);
}

/* ===== FOOTER ===== */
.footer-text{
  margin-top:18px;
  font-size:13px;
  color:#666;
}
</style>
</head>

<body>

<div class="thank-card">

  <!-- Icon -->
  <div class="check">✓</div>

  <!-- Heading -->
  <h1>Thank You for Your Donation!</h1>
  <p>Your kindness helps make the world a better place 🌍</p>

  <!-- Summary -->
  <div class="summary">
    <h3>Donation Summary</h3>

    <div>
      <span>Foundation</span>
      <span><%= foundation[0].foundation_name %></span>
    </div>

    <div>
      <span>Amount</span>
      <span>₹ <%= donation[0].amount %></span>
    </div>

    <div>
      <span>Transaction ID</span>
      <span><%= donation[0].transaction_id %></span>
    </div>

    <div>
      <span>Date</span>
      <span><%= donation[0].date %></span>
    </div>
  </div>

  <!-- Buttons -->
  <div class="actions">
    <a href="/invoice/pdf/<%= donation[0].donation_id %>" class="invoice-btn">Download Invoice</a>
    <a href="/" class="home-btn">Go to Home</a>
  </div>

  <div class="footer-text">
    A confirmation email has been sent to you 📧
  </div>

</div>

</body>
</html>
