<%-include("style")%>
<%-include("header")%>

<style>



/* ================= NAVBAR ================= */

/* ================= HERO ================= */
.hero{
    background:linear-gradient(rgba(30,60,114,0.9),rgba(42,82,152,0.9)),url('https://images.unsplash.com/photo-1521790797524-b2497295b8a0');
    background-size:cover;
    background-position:center;
    height:300px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:white;
    text-align:center;
}

.hero h1{
    font-size:40px;
}

.hero p{
    margin-top:10px;
}

/* ================= CONTACT SECTION ================= */
.contact-section{
    padding:60px 8%;
    display:flex;
    flex-wrap:wrap;
    gap:50px;
}

/* Contact Info */
.contact-info{
    flex:1;
    min-width:300px;
}

.info-box{
    background:white;
    padding:25px;
    margin-bottom:20px;
    border-radius:10px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
    display:flex;
    align-items:center;
    gap:20px;
    transition:0.3s;
}

.info-box:hover{
    transform:translateY(-5px);
}

.info-box i{
    font-size:24px;
    color:#1e3c72;
}

/* Contact Form */
.contact-form{
    flex:1;
    min-width:300px;
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.contact-form h2{
    margin-bottom:20px;
}

.input-group{
    margin-bottom:15px;
}

.input-group input,
.input-group textarea{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:6px;
    font-size:14px;
    transition:0.3s;
}

.input-group input:focus,
.input-group textarea:focus{
    border-color:#1e3c72;
    outline:none;
}

textarea{
    resize:none;
    height:120px;
}

button{
    background:#1e3c72;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:6px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#2a5298;
}

/* ================= MAP ================= */
.map{
    width:100%;
    margin-top:50px;
}

iframe{
    width:100%;
    height:300px;
    border:0;
    border-radius:10px;
}

/* ================= FOOTER ================= */

/* ================= RESPONSIVE ================= */
@media(max-width:768px){
    .contact-section{
        flex-direction:column;
    }
}
</style>

<!-- NAVBAR -->


<!-- HERO -->
<section class="hero">
    <div>
        <h1>Contact Us</h1>
        <p>We’d love to hear from you. Reach out anytime.</p>
    </div>
</section>

<!-- CONTACT SECTION -->
<section class="contact-section">

    <!-- Contact Info -->
    <div class="contact-info">
        <div class="info-box">
            <i class="fas fa-map-marker-alt"></i>
            <div>
                <h4>Address</h4>
                <p><%= site[0].address %></p>
            </div>
        </div>

        <div class="info-box">
            <i class="fas fa-phone"></i>
            <div>
                <h4>Phone</h4>
                <p>+91 <%= site[0].phone %></p>
            </div>
        </div>

        <div class="info-box">
            <i class="fas fa-envelope"></i>
            <div>
                <h4>Email</h4>
                <p><%= site[0].contact_email %></p>
            </div>
        </div>
    </div>

    <!-- Contact Form -->
    <div class="contact-form">
        <h2>Send Message</h2>
        <form id="contactForm">
            <div class="input-group">
                <input type="text" placeholder="Full Name" required>
            </div>
            <div class="input-group">
                <input type="email" placeholder="Email Address" required>
            </div>
            <div class="input-group">
                <input type="text" placeholder="Subject" required>
            </div>
            <div class="input-group">
                <textarea placeholder="Your Message" required></textarea>
            </div>
            <button type="submit">Send Message</button>
        </form>
    </div>

</section>

<!-- MAP -->
<div class="map">
    <iframe src="https://maps.google.com/maps?q=india&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe>
</div>

<!-- FOOTER -->

<script>
document.getElementById("contactForm").addEventListener("submit", function(e){
    e.preventDefault();
    alert("Thank you! Your message has been sent successfully.");
});
</script>

<%-include("footer")%>