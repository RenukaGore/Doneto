<body>
<div id="loader">
    <div class="loader-content">
        <div class="heart-wrapper">
            <i class="fa-solid fa-heart heart"></i>
            <div class="pulse"></div>
        </div>
        <h3 class="brand">Doneto</h3>
        <p class="loading-text">Spreading Kindness...</p>
    </div>
</div>
  <header class="navbar" id="navbar">
    <div class="logo ml-3">
      <!-- <img src="logo.png" alt="Done-To Logo"> -->
      <span><%= site[0].site_name %></span>
    </div>

    <nav>
      <ul class="nav-links pt-3 ">
        <li style="--i:1"><a href="/">Home</a></li>
        <li style="--i:2"><a href="/about">About</a></li>
        <li style="--i:4"><a href="/foundation_page">Foundation</a></li>
        <li style="--i:5"><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <% if(is_login){%>
    <p ><a style="color: white;margin-right: 10px;" href="/logout" > <i class="fa fa-sign-out-alt fa-sm "></i> Logout</a>
    <a style="color: white;" href="/profile" > <i class="fa fa-user"></i> profile</a></p>

    <%}else{%>
    <a href="/login" class="donate-btn">Login</a>
    <%}%>
