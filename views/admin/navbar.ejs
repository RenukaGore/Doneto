
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DoneTo Admin</title>
    <link rel="icon" type="image/x-icon" href="/upload/title_logo.png">
    
    <link rel="apple-touch-icon" href="/upload/title_logo.png">

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
 
    <style>
        body {
            background: #0b0b0b;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Sidebar hover */
        .sidebar-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transition: 0.3s;
        }

        /* Cards */
        .foundation-card {
            background: linear-gradient(145deg, #141414, #1f1f1f);
            color: #fff;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 0 40px rgba(0, 255, 255, 0.15);
            transition: 0.4s ease;
        }

        .foundation-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 0 60px rgba(0, 255, 255, 0.25);
        }

        .foundation-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: 2px solid #00ffd5;
            object-fit: cover;
        }

        .status {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 20px;
        }

        .status.active {
            background: #00c853;
        }

        .status.inactive {
            background: #d50000;
        }

        /* Mobile fixes */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .foundation-card {
                padding: 18px;
            }
        }
    </style>
</head>

<body class="text-slate-100">

    <!-- Wrapper -->
    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <aside id="sidebar" class="fixed md:static z-50 w-64 h-full bg-slate-800/90 border-r border-slate-700
            flex flex-col p-6 backdrop-blur-xl
            transform -translate-x-full md:translate-x-0 transition-transform duration-300">

            <div class="flex items-center gap-3 mb-10">
                <div class="bg-indigo-500 p-2 rounded-lg">
                    <i data-lucide="layout-dashboard"></i>
                </div>
                <h1 class="text-xl font-bold">DoneTo</h1>
            </div>

            <nav class="space-y-2 flex-1">
                <a href="/admin"
                    class="sidebar-item flex items-center gap-3 p-3 rounded-xl <%= distribution=='index' ? 'bg-indigo-600/20 text-indigo-400' : 'text-slate-400' %>">
                    <i data-lucide="home"></i> Dashboard
                </a>

                <a href="/admin/foundation_list"
                    class="sidebar-item flex items-center gap-3 p-3 rounded-xl <%= distribution=='foundation_list' ? 'bg-indigo-600/20 text-indigo-400' : 'text-slate-400' %>">
                    <i data-lucide="building"></i> Foundations
                </a>

                <a href="/admin/distribute_fund" 
                class="sidebar-item flex items-center gap-3 p-3 rounded-xl
                    <%= distribution =='fund' ? 'bg-indigo-600/20 text-indigo-400' : 'text-slate-400' %>">
                    <i data-lucide="hand-coins"></i> Distribute Fund
                </a>


                <a href="/admin/slider" class="sidebar-item flex items-center gap-3 p-3 rounded-xl <%= distribution =='slider' ? 'bg-indigo-600/20 text-indigo-400' : 'text-slate-400' %>">
                    <i data-lucide="images"></i> Slider
                </a>

                <a href="/admin/setting" class="sidebar-item flex items-center gap-3 p-3 rounded-xl <%= distribution=='setting' ? 'bg-indigo-600/20 text-indigo-400' : 'text-slate-400' %>">
                    <i data-lucide="settings"></i> Settings
                </a>
            </nav>

            <!-- <div class="mt-auto p-4 bg-slate-800 rounded-2xl border border-slate-700">
                <p class="text-xs text-slate-400">Current Plan</p>
                <p class="text-sm font-semibold mb-3">Enterprise Pro</p>
                <button class="w-full bg-slate-700 hover:bg-slate-600 py-2 rounded-lg text-xs">
                    Upgrade
                </button>
            </div> -->
        </aside>

        <!-- Main -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6">

            <!-- Header -->
            <header class="flex justify-between items-center mb-8">

                <!-- Mobile Menu -->
                <button id="menuBtn" class="md:hidden p-2 bg-slate-800 rounded-lg border border-slate-700">
                    <i data-lucide="menu"></i>
                </button>

                <div>
                    <h2 class="text-3xl font-bold">Hello, Harish 👋</h2>
                    <p class="text-slate-400">Manage your donation platform</p>
                </div>
        <p class="text-white " id="live-clock"></p>

                <div class="flex items-center gap-4">
                    <button class="p-2 bg-slate-800 rounded-full border border-slate-700">
                        <i data-lucide="bell"></i>
                    </button>
                    <img src="/upload/admin_logo.jpg" class="w-10 h-10 rounded-full border-2 border-indigo-500">
                </div>
            </header>