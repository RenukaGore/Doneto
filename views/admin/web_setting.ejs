<%-include("navbar")%>
<style>


/* CONTAINER */
.settings-container{
    max-width:900px;
    margin:auto;
    background:#111827;
    border-radius:18px;
    box-shadow:0 20px 50px rgba(0,0,0,.6);
    animation:fadeIn .8s ease;
}

/* HEADER */
.settings-header{
    padding:25px 30px;
    border-bottom:1px solid #1f2937;
}

.settings-header h2{
    font-size:24px;
}

/* FORM */
.settings-form{
    padding:30px;
}

.section{
    margin-bottom:35px;
}

.section h3{
    margin-bottom:15px;
    font-size:18px;
    color:#38bdf8;
}

/* INPUTS */
label{
    display:block;
    margin-bottom:6px;
    font-size:14px;
    opacity:.85;
}

input, textarea{
    width:100%;
    padding:12px;
    border-radius:10px;
    border:1px solid #1f2937;
    background:#020617;
    color:#fff;
    margin-bottom:15px;
}

input:focus, textarea:focus{
    outline:none;
    border-color:#2563eb;
}

textarea{
    resize:none;
}

/* LOGO PREVIEW */
.logo-preview{
    display:flex;
    align-items:center;
    gap:20px;
}

.logo-preview img{
    width:80px;
    height:80px;
    border-radius:12px;
    object-fit:cover;
    border:2px solid #2563eb;
}

/* BUTTON */
.save-btn{
    background:linear-gradient(135deg,#22c55e,#16a34a);
    color:#000;
    padding:14px 30px;
    border:none;
    border-radius:30px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

.save-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 30px rgba(34,197,94,.5);
}

/* ANIMATION */
@keyframes fadeIn{
    from{opacity:0;transform:translateY(30px)}
    to{opacity:1;transform:translateY(0)}
}

/* RESPONSIVE */
@media(max-width:600px){
    body{padding:20px}
}
</style>
</head>

<body>

<div class="settings-container">

    <!-- HEADER -->
    <div class="settings-header">
        <h2>Website Settings</h2>
        <p style="opacity:.7">Manage branding and footer details</p>
    </div>

    <!-- FORM -->
    <form class="settings-form" action="/admin/web_setting" method="post" enctype="multipart/form-data">

        <!-- LOGO -->
        <div class="section">
            <h3>Website Branding</h3>

            <label>Website Logo</label>
            <div class="logo-preview">
                <img src="/upload/<%=site[0].site_logo%>" alt="Logo">
                <input type="file" name="site_logo">
            </div>

            <label>Website Name</label>
            <input type="text" name="site_name" value="<%=site[0].site_name%>">

            <label>Tagline</label>
            <input type="text" name="tagline" value="<%=site[0].tagline%>">
        </div>

        <!-- FOOTER -->
        <div class="section">
            <h3>Footer Details</h3>

            <label>Footer Text</label>
            <textarea rows="3" name="footer_text"><%=site[0].footer_text%></textarea>

            <label>Contact Email</label>
            <input type="email" name="contact_email" value="<%=site[0].contact_email%>">
            <label>Contact mobile</label>
            <input type="number" name="phone" value="<%=site[0].phone%>">

            
            <label>Instagram</label>
            <input type="text" name="instagram" value="<%=site[0].instagram%>">
            <label>Facebook</label>
            <input type="text" name="facebook" value="<%=site[0].facebook%>">
            <label>Twitter</label>
            <input type="text" name="twitter" value="<%=site[0].twitter%>">
            
        </div>

        <!-- BUTTON -->
        <button class="save-btn">Save Changes</button>

    </form>

</div>
<%-include("footer")%>
